# ══════════════════════════════════════════
# FinanzasAP — Environment Variables
# ══════════════════════════════════════════

# ─── Base URL ───
PUBLIC_APP_URL=http://localhost:4321

# ─── Database (TiDB Cloud) ───
DATABASE_URL=mysql://user:password@host:4000/finanzas_ap?ssl={}

# ─── Auth (Better Auth) ───
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
BETTER_AUTH_URL=http://localhost:4321

# ─── Email (Resend) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourfinanzas.app

# ─── Security (Arcjet) ───
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxx

# ─── Monitoring (Sentry) ───
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxxx
