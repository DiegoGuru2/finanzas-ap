# ══════════════════════════════════════════
# ProyecAhorro — Environment Variables
# ══════════════════════════════════════════

# ─── Base URL ───
PUBLIC_APP_URL=http://localhost:4321

# ─── Database (TiDB Cloud) ───
DATABASE_URL=mysql://user:password@host:4000/finanzas_ap?ssl={"rejectUnauthorized":true}

# ─── Auth (Better Auth) ───
# ⚠️ Mínimo 32 caracteres. Genera con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
BETTER_AUTH_URL=http://localhost:4321

# ─── Email (Gmail SMTP con App Password) ───
SMTP_USER=tu-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Google OAuth (Opcional) ───
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# ─── Telegram Bot (Alertas y Asistente Financiero) ───
# Obtén tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_BOT_USERNAME=TuBotDeFinanzas_bot
# Secreto opcional para proteger el webhook
TELEGRAM_WEBHOOK_SECRET=un_secreto_aleatorio_seguro
