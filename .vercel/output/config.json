{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/debts/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/expenses/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/incomes/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/payments/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/schedule/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/debts/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/expenses/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/incomes/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/payments/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}