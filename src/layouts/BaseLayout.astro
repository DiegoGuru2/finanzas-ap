---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'ProyecAhorro — Gestiona hoy, proyecta tu mañana. Organiza tus ingresos, ahorra mejor y alcanza tus metas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a2e" />

    <!-- Aplicar el tema guardado ANTES del primer render para evitar parpadeo -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          if (localStorage.getItem('finanzas-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
        } catch (e) {}
      })();
    </script>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" type="image/png" href="/images/logo-icon.png" />
    <link rel="apple-touch-icon" href="/images/logo-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ProyecAhorro" />

    <title>{title} | ProyecAhorro</title>
  </head>
  <body class="min-h-screen bg-surface-0 text-text-primary antialiased">
    <!-- Global Preloader -->
    <div
      id="global-preloader"
      class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-surface-0 transition-opacity duration-300 ease-out"
    >
      <div class="relative flex flex-col items-center gap-3">
        <!-- Glowing ring + Logo -->
        <div class="relative flex items-center justify-center">
          <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-brand-500/40 to-accent-400/40 blur-md animate-pulse"></div>
          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-surface-50 border border-border-default shadow-xl">
            <img src="/images/logo-icon.png" alt="ProyecAhorro Logo" class="h-11 w-11 object-contain dark-hidden animate-pulse" />
            <img src="/images/logo-dark.png" alt="ProyecAhorro Logo" class="h-11 w-11 object-contain light-hidden animate-pulse" />
          </div>
        </div>

        <div class="flex flex-col items-center">
          <span class="text-base font-black tracking-tight text-text-primary">
            Proyec<span class="text-accent-400">Ahorro</span>
          </span>
        </div>

        <!-- Progress bar -->
        <div class="w-24 h-1 bg-surface-200 rounded-full overflow-hidden mt-1">
          <div class="h-full bg-gradient-to-r from-brand-500 to-accent-400 rounded-full animate-indeterminate"></div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Fast smooth dismiss of preloader
      window.addEventListener('load', () => {
        const p = document.getElementById('global-preloader');
        if (p) {
          p.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => p.remove(), 350);
        }
      });
      // Fallback timeout in case window load takes long
      setTimeout(() => {
        const p = document.getElementById('global-preloader');
        if (p) {
          p.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => p.remove(), 350);
        }
      }, 1500);
    </script>

    <slot />

    <!-- Service Worker registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>

