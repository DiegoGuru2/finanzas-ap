---
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginForm from '@/components/auth/LoginForm';
---

<AuthLayout title="Iniciar sesión" description="Inicia sesión en tu cuenta de ProyecAhorro">
  <div class="glass rounded-2xl p-6 sm:p-8 shadow-2xl relative">
    <!-- Close / Return button in top-right corner with tooltip -->
    <div class="absolute top-4 right-4 sm:top-5 sm:right-5 z-20">
      <div class="relative group flex items-center justify-center">
        <a
          href="/"
          aria-label="Volver a la página principal"
          class="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-100/60 border border-border-default/80 text-text-muted hover:text-text-primary hover:bg-surface-100 hover:border-brand-500/40 hover:rotate-90 transition-all duration-200 cursor-pointer shadow-2xs"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </a>

        <!-- Hover Tooltip -->
        <div class="pointer-events-none absolute right-0 top-full mt-2 hidden sm:flex opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-30 whitespace-nowrap">
          <div class="rounded-lg bg-surface-200 border border-border-default px-2.5 py-1 text-[11px] font-semibold text-text-primary shadow-lg">
            Volver a la página principal
          </div>
        </div>
      </div>
    </div>

    <!-- Logo -->
    <div class="mb-6 text-center">
      <a href="/" class="inline-flex flex-col items-center gap-2 group">
        <img
          src="/images/logo-icon.png"
          alt="ProyecAhorro Logo"
          class="h-14 w-14 object-contain rounded-xl shadow-lg transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col items-center">
          <span class="text-xl font-black tracking-tight text-text-primary">
            Proyec<span class="text-accent-400">Ahorro</span>
          </span>
          <span class="text-[10px] text-text-muted font-semibold tracking-wider uppercase -mt-0.5">
            Gestiona hoy, proyecta tu mañana
          </span>
        </div>
      </a>
      <h1 class="mt-4 text-xl font-bold text-text-primary">Bienvenido de nuevo</h1>
      <p class="mt-0.5 text-xs text-text-secondary">
        Ingresa a tu cuenta para continuar
      </p>
    </div>

    <!-- Login Form Island -->
    <LoginForm client:load />

    <!-- Register link -->
    <p class="mt-6 text-center text-xs text-text-muted">
      ¿No tienes cuenta?{' '}
      <a href="/register" class="font-semibold text-brand-400 hover:text-brand-300">
        Crear cuenta
      </a>
    </p>
  </div>
</AuthLayout>
