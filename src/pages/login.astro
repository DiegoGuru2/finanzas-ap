---
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginForm from '@/components/auth/LoginForm';
---

<AuthLayout title="Iniciar sesión" description="Inicia sesión en tu cuenta de FinanzasAP">
  <div class="glass rounded-2xl p-8 shadow-2xl">
    <!-- Logo -->
    <div class="mb-8 text-center">
      <div
        class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/25"
      >
        <svg
          class="h-7 w-7 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h1 class="mt-4 text-2xl font-bold">Bienvenido de nuevo</h1>
      <p class="mt-1 text-sm text-text-secondary">
        Ingresa a tu cuenta para continuar
      </p>
    </div>

    <!-- Login Form Island -->
    <LoginForm client:load />

    <!-- Register link -->
    <p class="mt-6 text-center text-sm text-text-muted">
      ¿No tienes cuenta?{' '}
      <a href="/register" class="font-medium text-brand-400 hover:text-brand-300">
        Crear cuenta
      </a>
    </p>
  </div>
</AuthLayout>
