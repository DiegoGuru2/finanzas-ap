---
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginForm from '@/components/auth/LoginForm';
---

<AuthLayout title="Iniciar sesión" description="Inicia sesión en tu cuenta de ProyecAhorro">
  <div class="glass rounded-2xl p-8 shadow-2xl">
    <!-- Logo -->
    <div class="mb-6 text-center">
      <a href="/" class="inline-flex flex-col items-center gap-2 group">
        <img
          src="/images/logo-icon.png"
          alt="ProyecAhorro Logo"
          class="h-14 w-14 object-contain rounded-xl shadow-lg transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col items-center">
          <span class="text-xl font-black tracking-tight text-text-primary">
            Proyec<span class="text-accent-400">Ahorro</span>
          </span>
          <span class="text-[10px] text-text-muted font-semibold tracking-wider uppercase -mt-0.5">
            Gestiona hoy, proyecta tu mañana
          </span>
        </div>
      </a>
      <h1 class="mt-4 text-xl font-bold text-text-primary">Bienvenido de nuevo</h1>
      <p class="mt-0.5 text-xs text-text-secondary">
        Ingresa a tu cuenta para continuar
      </p>
    </div>

    <!-- Login Form Island -->
    <LoginForm client:load />

    <!-- Register link -->
    <p class="mt-6 text-center text-xs text-text-muted">
      ¿No tienes cuenta?{' '}
      <a href="/register" class="font-semibold text-brand-400 hover:text-brand-300">
        Crear cuenta
      </a>
    </p>
  </div>
</AuthLayout>
