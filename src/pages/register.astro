---
import AuthLayout from '../layouts/AuthLayout.astro';
import RegisterForm from '@/components/auth/RegisterForm';
---

<AuthLayout
  title="Crear cuenta"
  description="Crea tu cuenta gratuita en ProyecAhorro"
  maxWidth="max-w-2xl"
>
  <div class="glass rounded-2xl p-8 shadow-2xl">
    <!-- Logo -->
    <div class="mb-6 text-center">
      <a href="/" class="inline-flex flex-col items-center gap-2 group">
        <img
          src="/images/logo-icon.png"
          alt="ProyecAhorro Logo"
          class="h-14 w-14 object-contain rounded-xl shadow-lg transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col items-center">
          <span class="text-xl font-black tracking-tight text-text-primary">
            Proyec<span class="text-accent-400">Ahorro</span>
          </span>
          <span class="text-[10px] text-text-muted font-semibold tracking-wider uppercase -mt-0.5">
            Gestiona hoy, proyecta tu mañana
          </span>
        </div>
      </a>
      <h1 class="mt-4 text-xl font-bold text-text-primary">Crea tu cuenta</h1>
      <p class="mt-0.5 text-xs text-text-secondary">
        Comienza a optimizar tus ingresos y gastos hoy
      </p>
    </div>

    <!-- Register Form Island -->
    <RegisterForm client:load />

    <!-- Login link -->
    <p class="mt-6 text-center text-xs text-text-muted">
      ¿Ya tienes cuenta?{' '}
      <a href="/login" class="font-semibold text-brand-400 hover:text-brand-300">
        Iniciar sesión
      </a>
    </p>
  </div>
</AuthLayout>
