---
interface NavItem {
  href: string;
  label: string;
  icon: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems: NavItem[] = [
  { href: '/admin/dashboard', label: 'Métricas Globales', icon: 'bar-chart' },
  { href: '/admin/users', label: 'Usuarios y Roles', icon: 'users' },
  { href: '/admin/institutions', label: 'Entidades Financieras', icon: 'building' },
  { href: '/admin/settings', label: 'Parámetros del Sistema', icon: 'sliders' },
  { href: '/admin/audit', label: 'Auditoría & DB', icon: 'shield-check' },
];

function isActive(href: string): boolean {
  if (href === '/admin/dashboard') return currentPath === '/admin/dashboard';
  return currentPath.startsWith(href);
}
---

<!-- Mobile overlay -->
<div
  id="admin-sidebar-overlay"
  class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-sm lg:hidden"
>
</div>

<!-- Admin Sidebar -->
<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-border-default bg-surface-50 transition-transform duration-300 ease-smooth lg:translate-x-0"
>
  <!-- Logo with ADMIN Badge -->
  <a href="/admin/dashboard" class="flex h-16 items-center gap-3 border-b border-border-default px-5 hover:bg-surface-100/50 transition-colors">
    <img
      src="/images/logo-icon.png"
      alt="ProyecAhorro Logo"
      class="h-9 w-9 object-contain rounded-lg shadow-sm dark-hidden"
    />
    <img
      src="/images/logo-dark.png"
      alt="ProyecAhorro Logo"
      class="h-9 w-9 object-contain rounded-lg shadow-sm light-hidden"
    />
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <span class="text-base font-extrabold tracking-tight text-text-primary leading-tight">
          Proyec<span class="text-accent-400">Ahorro</span>
        </span>
        <span class="rounded bg-brand-500/20 text-brand-400 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider">
          Admin
        </span>
      </div>
      <span class="text-[9px] text-text-muted font-medium tracking-wide">
        Panel de Administración
      </span>
    </div>
  </a>

  <!-- Navigation -->
  <nav class="flex-1 space-y-1 px-3 py-4">
    <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-text-muted">
      Administración
    </div>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'group flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-200',
            isActive(item.href)
              ? 'bg-brand-500/15 text-brand-400 shadow-sm font-semibold'
              : 'text-text-secondary hover:bg-surface-100 hover:text-text-primary',
          ]}
        >
          <span
            class:list={[
              'flex h-5 w-5 items-center justify-center',
              isActive(item.href)
                ? 'text-brand-400'
                : 'text-text-muted group-hover:text-text-secondary',
            ]}
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              {item.icon === 'bar-chart' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              )}
              {item.icon === 'users' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              )}
              {item.icon === 'building' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              )}
              {item.icon === 'sliders' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              )}
              {item.icon === 'shield-check' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              )}
            </svg>
          </span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <!-- Bottom section with logout & attribution -->
  <div class="border-t border-border-default p-3 space-y-2">
    <form method="POST" action="/logout">
      <button
        type="submit"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-semibold text-danger-400 transition-colors hover:bg-danger-500/10 cursor-pointer"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        Cerrar sesión
      </button>
    </form>

    <div class="px-3 pt-1 text-[10px] text-text-muted/70 text-center">
      Desarrollado por <strong class="text-accent-400 font-bold">DG design</strong>
    </div>
  </div>
</aside>
