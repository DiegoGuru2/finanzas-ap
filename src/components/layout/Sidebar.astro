---
interface NavItem {
  href: string;
  label: string;
  icon: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems: NavItem[] = [
  { href: '/app/dashboard', label: 'Dashboard', icon: 'layout-dashboard' },
  { href: '/app/debts', label: 'Deudas', icon: 'credit-card' },
  { href: '/app/incomes', label: 'Ingresos', icon: 'trending-up' },
  { href: '/app/expenses', label: 'Gastos', icon: 'receipt' },
  { href: '/app/payments', label: 'Pagos', icon: 'banknote' },
  { href: '/app/savings', label: 'Metas de Ahorro', icon: 'target' },
  { href: '/app/vault', label: 'Contraseñas', icon: 'lock' },
  { href: '/app/settings', label: 'Configuración', icon: 'settings' },
];

function isActive(href: string): boolean {
  if (href === '/app/dashboard') return currentPath === '/app/dashboard';
  return currentPath.startsWith(href);
}
---

<!-- Mobile overlay -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-sm lg:hidden"
>
</div>

<!-- Sidebar -->
<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-border-default bg-surface-50 transition-transform duration-300 ease-smooth lg:translate-x-0"
>
  <!-- Logo -->
  <a href="/app/dashboard" class="flex h-16 items-center gap-3 border-b border-border-default px-5 hover:bg-surface-100/50 transition-colors">
    <img
      src="/images/logo-icon.png"
      alt="ProyecAhorro Logo"
      class="h-9 w-9 object-contain rounded-lg shadow-sm dark-hidden"
    />
    <img
      src="/images/logo-dark.png"
      alt="ProyecAhorro Logo"
      class="h-9 w-9 object-contain rounded-lg shadow-sm light-hidden"
    />
    <div class="flex flex-col">
      <span class="text-base font-extrabold tracking-tight text-text-primary leading-tight">
        Proyec<span class="text-accent-400">Ahorro</span>
      </span>
      <span class="text-[9px] text-text-muted font-medium tracking-wide">
        Por DG design
      </span>
    </div>
  </a>

  <!-- Navigation -->
  <nav class="flex-1 space-y-1 px-3 py-4">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'group flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-200',
            isActive(item.href)
              ? 'bg-brand-500/15 text-brand-400 shadow-sm font-semibold'
              : 'text-text-secondary hover:bg-surface-100 hover:text-text-primary',
          ]}
        >
          <span
            class:list={[
              'flex h-5 w-5 items-center justify-center',
              isActive(item.href)
                ? 'text-brand-400'
                : 'text-text-muted group-hover:text-text-secondary',
            ]}
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              {item.icon === 'layout-dashboard' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 13a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"
                />
              )}
              {item.icon === 'credit-card' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                />
              )}
              {item.icon === 'trending-up' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                />
              )}
              {item.icon === 'receipt' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"
                />
              )}
              {item.icon === 'banknote' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M2 7a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V7zm10 3a2 2 0 100 4 2 2 0 000-4z"
                />
              )}
              {item.icon === 'target' && (
                <Fragment>
                  <circle cx="12" cy="12" r="9" stroke-width="1.5" />
                  <circle cx="12" cy="12" r="5" stroke-width="1.5" />
                  <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
                </Fragment>
              )}
              {item.icon === 'lock' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                />
              )}
              {item.icon === 'settings' && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                />
              )}
            </svg>
          </span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <!-- Bottom section with DG design attribution -->
  <div class="border-t border-border-default p-3 space-y-2">
    <form method="POST" action="/logout">
      <button
        type="submit"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-semibold text-danger-400 transition-colors hover:bg-danger-500/10 cursor-pointer"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          ></path>
        </svg>
        Cerrar sesión
      </button>
    </form>

    <div class="px-3 pt-1 text-[10px] text-text-muted/70 text-center">
      Desarrollado por <strong class="text-accent-400 font-bold">DG design</strong>
    </div>
  </div>
</aside>
